{
    "name": "the-lab-lockdown/game-showcase",
    "type": "project",
    "description": "Official Game Showcase Website for Game The Lab Lockdown",
    "keywords": ["laravel", "game-showcase", "the-lab-lockdown", "blade", "tailwind"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
